# ==============================================================================
# Environment Configuration Example
# Copy to .env and adjust variables for your local setup. Never commit secrets!
# ==============================================================================

# Application & Environment
APP_NAME="University Examination Timetable Scheduling System"
APP_ENV="development" # development | test | production
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Secret Keys
# Generate with: openssl rand -hex 32
JWT_SECRET="changethisinproduction_min32chars_random_secret_key_here"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# In local Docker: postgresql+psycopg://postgres:postgres@localhost:5432/exam_scheduler
# SQLite fallback: sqlite+aiosqlite:///./exam_scheduler.db or sqlite:///./exam_scheduler.db
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/exam_scheduler"
TEST_DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/exam_scheduler_test"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# CORS Configuration
# Comma-separated allowed origins (no wildcard in production)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Upload and Processing Bounds
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB
MAX_CSV_ROWS=50000

# Rate Limiting
RATE_LIMIT_DEFAULT="100/minute"
RATE_LIMIT_AUTH="10/minute"
RATE_LIMIT_GENERATE="10/minute"

# Initial Admin Seed
ADMIN_EMAIL="admin@university.edu"
ADMIN_PASSWORD="AdminChangeMe123!"
ADMIN_FULL_NAME="System Administrator"
